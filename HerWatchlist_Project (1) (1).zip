    // Fix Signal's emoji cleanly
    STARTER_CATALOG.find(item => item.title === "Signal").emoji = "📻";

    /**
     * Application State
     */
    const state = {
      activeTab: "Discover",
      watchlist: [],
      watchStatus: {},
      messages: [],
      language: "Bahasa Indonesia",
      tone: "Casual & friendly",
      temperature: 0.65,
      apiKey: ""
    };

    const STORAGE_KEY_WATCHLIST = "herwatchlist_saved_titles_v1";
    const STORAGE_KEY_STATUS = "herwatchlist_watch_status_v1";

    function loadWatchlistState() {
      try {
        const savedList = JSON.parse(localStorage.getItem(STORAGE_KEY_WATCHLIST) || "[]");
        const savedStatus = JSON.parse(localStorage.getItem(STORAGE_KEY_STATUS) || "{}");
        if (Array.isArray(savedList)) state.watchlist = savedList;
        if (savedStatus && typeof savedStatus === "object") state.watchStatus = savedStatus;
      } catch (e) {
        state.watchlist = [];
        state.watchStatus = {};
      }
    }

    function saveWatchlistState() {
      try {
        localStorage.setItem(STORAGE_KEY_WATCHLIST, JSON.stringify(state.watchlist));
        localStorage.setItem(STORAGE_KEY_STATUS, JSON.stringify(state.watchStatus));
      } catch (e) {
        // Ignore storage quota issues in restricted frames
      }
    }

    function escapeHTML(str) {
      return String(str)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function showToast(message) {
      const container = document.getElementById("toastContainer");
      if (!container) return;
      const toast = document.createElement("div");
      toast.className = "toast-enter px-4 py-2.5 rounded-xl bg-[#71384f] text-white text-xs font-semibold shadow-lg border border-[#b45c7d]/40";
      toast.textContent = message;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = "0";
        toast.style.transition = "opacity 0.25s ease";
        setTimeout(() => toast.remove(), 260);
      }, 2400);
    }

    function updateWatchlistBadge() {
      const badge = document.getElementById("watchlistCountBadge");
      if (badge) badge.textContent = String(state.watchlist.length);
    }

    function addToWatchlist(title) {
      if (!state.watchlist.includes(title)) {
        state.watchlist.push(title);
        state.watchStatus[title] = "Want to Watch";
        saveWatchlistState();
        updateWatchlistBadge();
        showToast(`${title} added to your watchlist ♡`);
        renderMoodSection();
        renderCatalogGrid();
        if (state.activeTab === "My Watchlist") renderWatchlistPage();
      }
    }

    function removeFromWatchlist(title) {
      state.watchlist = state.watchlist.filter(t => t !== title);
      delete state.watchStatus[title];
      saveWatchlistState();
      updateWatchlistBadge();
      showToast(`Removed "${title}" from watchlist`);
      renderMoodSection();
      renderCatalogGrid();
      renderWatchlistPage();
    }

    function openMobileSidebar() {
      document.getElementById("sidebar").classList.remove("-translate-x-full");
      document.getElementById("sidebarBackdrop").classList.remove("hidden");
    }

    function closeMobileSidebar() {
      document.getElementById("sidebar").classList.add("-translate-x-full");
      document.getElementById("sidebarBackdrop").classList.add("hidden");
    }

    function switchTab(tabName) {
      state.activeTab = tabName;

      document.querySelectorAll(".nav-btn").forEach(btn => {
        const isActive = btn.dataset.tab === tabName;
        btn.className = isActive
          ? "nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-semibold transition bg-[#b45c7d] text-white shadow-xs cursor-pointer"
          : "nav-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-semibold transition text-[#71384f] hover:bg-[#f3dce6] cursor-pointer";
      });

      document.querySelectorAll(".tab-page").forEach(section => {
        section.classList.toggle("hidden", section.id !== `page-${tabName}`);
      });

      if (tabName === "Discover") {
        renderMoodSection();
        renderCatalogGrid();
      } else if (tabName === "My Watchlist") {
        renderWatchlistPage();
      }

      closeMobileSidebar();
    }

    function createMovieCardElement(item) {
      const isAdded = state.watchlist.includes(item.title);
      const card = document.createElement("article");
      card.className = "rounded-[18px] border border-[#f0e2e8] bg-white p-5 flex flex-col justify-between shadow-[0_5px_18px_rgba(113,56,79,0.045)] hover:border-[#e4c2d1] transition";

      const warningHtml = item.content_warning
        ? `<p class="text-[11px] text-[#9b5873] bg-[#fbf0f4] border border-[#f3dfe7] rounded-lg px-2.5 py-1 mt-2.5">Note: ${escapeHTML(item.content_warning)}</p>`
        : "";

      card.innerHTML = `
        <div>
          <div class="w-12 h-12 rounded-[15px] bg-[#fbf0f4] flex items-center justify-center text-2xl mb-3 border border-[#f3e1e9]">
            ${item.emoji}
          </div>
          <h3 class="font-playfair text-lg font-semibold text-[#71384f] leading-snug">${escapeHTML(item.title)}</h3>
          <p class="text-xs text-[#987b88] mt-1 mb-2.5">${escapeHTML(item.country)} · ${item.year} · ${escapeHTML(item.type)}</p>
          <p class="text-sm text-[#5f5057] leading-relaxed">${escapeHTML(item.synopsis)}</p>
          <p class="text-xs text-[#8b7780] mt-3"><span class="font-semibold text-[#775b68]">Genres:</span> ${escapeHTML(item.genres)}</p>
          ${warningHtml}
        </div>

        <div class="mt-4 pt-3 border-t border-[#f6eaef]">
          <button
            type="button"
            ${isAdded ? "disabled" : ""}
            class="w-full py-2 px-3 rounded-xl text-xs font-semibold transition ${
              isAdded
                ? "bg-[#f8eaf0] text-[#987b88] border border-[#efd8e2] cursor-default"
                : "bg-[#fff8fb] text-[#71384f] border border-[#e6c7d5] hover:bg-[#f8eaf0] hover:border-[#b45c7d] cursor-pointer"
            }"
          >
            ${isAdded ? "♡ Added to watchlist" : "＋ Add to watchlist"}
          </button>
        </div>
      `;

      const btn = card.querySelector("button");
      if (!isAdded) {
        btn.addEventListener("click", () => addToWatchlist(item.title));
      }

      return card;
    }

    function moodSuggestions(mood) {
      const mapping = {
        "I need comfort": ["Comfort", "Heartwarming", "Feel-good", "Romance"],
        "Something romantic": ["Romance"],
        "I want to laugh": ["Comedy", "Romance", "Feel-good"],
        "A little mystery": ["Mystery", "Thriller"],
        "Something exciting": ["Thriller", "Mystery", "Adventure"],
        "A coming-of-age story": ["Coming of Age", "Youth", "Drama"]
      };
      const terms = mapping[mood] || [];
      if (terms.length === 0) return STARTER_CATALOG.slice(0, 3);
      const matches = STARTER_CATALOG.filter(item => {
        const g = item.genres.toLowerCase();
        return terms.some(t => g.includes(t.toLowerCase()));
      });
      return (matches.length > 0 ? matches : STARTER_CATALOG).slice(0, 3);
    }

    function renderMoodSection() {
      const selector = document.getElementById("moodSelector");
      const container = document.getElementById("moodPicksContainer");
      const label = document.getElementById("moodPicksLabel");
      const grid = document.getElementById("moodPicksGrid");
      if (!selector || !container || !label || !grid) return;

      const mood = selector.value;
      if (mood === "Just browsing") {
        container.classList.add("hidden");
        return;
      }

      container.classList.remove("hidden");
      label.innerHTML = `A few picks for: <em class="text-[#b45c7d]">${escapeHTML(mood)}</em>`;
      grid.innerHTML = "";
      moodSuggestions(mood).forEach(item => grid.appendChild(createMovieCardElement(item)));
    }

    function filterCatalog(category = "All", search = "") {
      let result = [...STARTER_CATALOG];
      if (category !== "All") {
        result = result.filter(item => item.type === category);
      }
      const term = search.trim().toLowerCase();
      if (term) {
        result = result.filter(item => {
          const searchable = `${item.title} ${item.country} ${item.genres} ${item.synopsis} ${item.type}`.toLowerCase();
          return searchable.includes(term);
        });
      }
      return result;
    }

    function renderCatalogGrid() {
      const category = document.getElementById("categoryFilter").value;
      const search = document.getElementById("searchInput").value;
      const grid = document.getElementById("catalogGrid");
      const emptyState = document.getElementById("catalogEmptyState");
      const countEl = document.getElementById("catalogResultCount");

      const items = filterCatalog(category, search);
      grid.innerHTML = "";

      if (countEl) {
        countEl.textContent = `Showing ${items.length} of ${STARTER_CATALOG.length} curated stories`;
      }

      if (items.length === 0) {
        grid.classList.add("hidden");
        emptyState.classList.remove("hidden");
      } else {
        grid.classList.remove("hidden");
        emptyState.classList.add("hidden");
        items.forEach(item => grid.appendChild(createMovieCardElement(item)));
      }
    }

    /**
     * Watchlist Page Rendering
     */
    function renderWatchlistPage() {
      const container = document.getElementById("watchlistContainer");
      const emptyState = document.getElementById("watchlistEmptyState");
      const summaryText = document.getElementById("watchlistSummaryText");
      const statusFilterEl = document.getElementById("watchlistStatusFilter");
      const selectedStatus = statusFilterEl ? statusFilterEl.value : "All";

      container.innerHTML = "";

      if (state.watchlist.length === 0) {
        container.classList.add("hidden");
        emptyState.classList.remove("hidden");
        summaryText.textContent = "";
        return;
      }

      const filteredTitles = selectedStatus === "All"
        ? state.watchlist
        : state.watchlist.filter(title => (state.watchStatus[title] || "Want to Watch") === selectedStatus);

      container.classList.remove("hidden");
      emptyState.classList.add("hidden");
      summaryText.textContent = `${filteredTitles.length} of ${state.watchlist.length} ${state.watchlist.length === 1 ? "title" : "titles"}`;

      if (filteredTitles.length === 0) {
        container.innerHTML = `
          <div class="rounded-2xl border border-[#efd9e3] bg-[#fff8fb] p-6 text-center text-sm text-[#775b68]">
            No titles marked as <strong>${escapeHTML(selectedStatus)}</strong> yet.
          </div>
        `;
        return;
      }

      filteredTitles.forEach(title => {
        const item = STARTER_CATALOG.find(m => m.title === title);
        const currentStatus = state.watchStatus[title] || "Want to Watch";

        const row = document.createElement("div");
        row.className = "rounded-2xl border border-[#f0e2e8] bg-white p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-[0_4px_14px_rgba(113,56,79,0.03)]";

        const metaLine = item
          ? `${escapeHTML(item.country)} · ${item.year} · ${escapeHTML(item.genres)}`
          : "Saved title";

        row.innerHTML = `
          <div class="flex items-start gap-3.5">
            <div class="w-11 h-11 rounded-xl bg-[#fbf0f4] flex items-center justify-center text-xl shrink-0 border border-[#f3e1e9]">
              ${item ? item.emoji : "♡"}
            </div>
            <div>
              <h3 class="font-playfair text-base sm:text-lg font-semibold text-[#71384f]">${escapeHTML(title)}</h3>
              <p class="text-xs text-[#8b7780] mt-0.5">${metaLine}</p>
            </div>
          </div>

          <div class="flex items-center gap-2.5 self-end sm:self-center">
            <label class="sr-only">Status for ${escapeHTML(title)}</label>
            <select data-status-title="${escapeHTML(title)}" class="status-select rounded-xl bg-[#fff8fb] border border-[#e6c7d5] px-3 py-2 text-xs font-semibold text-[#71384f] focus:outline-none focus:border-[#b45c7d] cursor-pointer">
              <option value="Want to Watch" ${currentStatus === "Want to Watch" ? "selected" : ""}>Want to Watch</option>
              <option value="Currently Watching" ${currentStatus === "Currently Watching" ? "selected" : ""}>Currently Watching</option>
              <option value="Completed" ${currentStatus === "Completed" ? "selected" : ""}>Completed</option>
            </select>

            <button type="button" data-remove-title="${escapeHTML(title)}" class="remove-watchlist-btn px-3.5 py-2 rounded-xl border border-[#e6c7d5] bg-white hover:bg-[#f8eaf0] hover:border-[#b45c7d] text-xs font-semibold text-[#71384f] transition cursor-pointer">
              Remove
            </button>
          </div>
        `;

        row.querySelector(".status-select").addEventListener("change", (e) => {
          state.watchStatus[title] = e.target.value;
          saveWatchlistState();
          showToast(`Updated "${title}" to ${e.target.value}`);
        });

        row.querySelector(".remove-watchlist-btn").addEventListener("click", () => {
          removeFromWatchlist(title);
        });

        container.appendChild(row);
      });
    }

    /**
     * Hera AI Chat Engine (Live Groq API + Built-in Smart Catalog Fallback)
     */
    function initChatWelcome() {
      if (state.messages.length === 0) {
        state.messages.push({
          role: "assistant",
          content: "Hai! Aku **Hera** ♡ Ceritain mood kamu hari ini atau genre yang lagi pengen ditonton (K-drama, C-drama, atau Western movie)—aku bakal bantu pilihkan cerita yang pas dan bebas spoiler!"
        });
      }
      renderChatMessages();
    }

    function formatBasicMarkdown(text) {
      const escaped = escapeHTML(text);
      return escaped
        .replace(/\*\*(.+?)\*\*/g, '<strong class="font-semibold text-[#71384f]">$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/\n/g, "<br>");
    }

    function renderChatMessages(isTyping = false) {
      const container = document.getElementById("chatMessagesContainer");
      container.innerHTML = "";

      state.messages.forEach(msg => {
        const wrapper = document.createElement("div");
        const isAssistant = msg.role === "assistant";

        wrapper.className = `flex items-start gap-3 ${isAssistant ? "" : "flex-row-reverse"}`;

        const avatar = isAssistant
          ? `<div class="w-8 h-8 rounded-full bg-[#f8eaf0] border border-[#e6c7d5] text-[#b45c7d] flex items-center justify-center text-sm font-bold shrink-0">♡</div>`
          : `<div class="w-8 h-8 rounded-full bg-[#71384f] text-white flex items-center justify-center text-xs font-semibold shrink-0">You</div>`;

        const bubbleStyle = isAssistant
          ? "bg-[#fffaf7] border border-[#f1e2e8] text-[#5f5057]"
          : "bg-[#f8eaf0] border border-[#e6c7d5] text-[#71384f]";

        wrapper.innerHTML = `
          ${avatar}
          <div class="max-w-[82%] sm:max-w-[75%] rounded-2xl px-4 py-3 text-sm leading-relaxed ${bubbleStyle}">
            ${formatBasicMarkdown(msg.content)}
          </div>
        `;

        container.appendChild(wrapper);
      });

      if (isTyping) {
        const typingEl = document.createElement("div");
        typingEl.className = "flex items-start gap-3";
        typingEl.innerHTML = `
          <div class="w-8 h-8 rounded-full bg-[#f8eaf0] border border-[#e6c7d5] text-[#b45c7d] flex items-center justify-center text-sm font-bold shrink-0">♡</div>
          <div class="rounded-2xl px-4 py-3 bg-[#fffaf7] border border-[#f1e2e8] text-[#8b7780] text-xs flex items-center gap-1.5">
            <span>Hera is finding your next story</span>
            <span class="typing-dot">•</span><span class="typing-dot">•</span><span class="typing-dot">•</span>
          </div>
        `;
        container.appendChild(typingEl);
      }

      container.scrollTop = container.scrollHeight;
    }

    /**
     * Build Messages Payload for Groq API (Mirrors utils/chatbot.py)
     */
    function buildGroqMessages() {
      const catalogLines = STARTER_CATALOG.map(row =>
        `- ${row.title} | ${row.country} | ${row.year} | ${row.type} | Genres: ${row.genres} | Synopsis: ${row.synopsis} | Content note: ${row.content_warning || "Not specified"}`
      ).join("\n");

      const system = `${HERA_SYSTEM_PROMPT}\n\nRESPONSE SETTINGS\nLanguage: ${state.language}\nTone: ${state.tone}\n\nCATALOG PROVIDED BY THE APP:\n${catalogLines}`;

      const recent = state.messages.slice(-12).map(m => ({
        role: m.role,
        content: m.content.slice(0, 3000)
      }));

      return [{ role: "system", content: system }, ...recent];
    }

    /**
     * Built-in Smart Local Curator Engine (Runs when no Groq API key is entered)
     */
    function generateLocalHeraResponse(userPrompt) {
      const q = userPrompt.toLowerCase();
      const lang = state.language;
      const tone = state.tone;

      // 1. Spoiler Guardrail
      if (/\b(spoiler|ending|who dies|siapa yang mati|akhir cerita|plot twist)\b/.test(q)) {
        if (lang === "English") {
          return "I keep all recommendations spoiler-free by default so nothing gets ruined for you ♡ If you're sure you want spoilers for a specific title, please reply to confirm first!";
        }
        return "Secara default aku selalu menjaga semua rekomendasi tetap bebas spoiler biar kejutan ceritanya nggak rusak ♡ Kalau kamu memang yakin mau tahu spoilernya, konfirmasi dulu di pesan berikutnya ya!";
      }

      // 2. Out-of-scope Guardrail (coding, math, politics, system prompt)
      if (/\b(system prompt|api key|ignore previous|python|javascript|coding|code|math|politik|resep masakan)\b/.test(q)) {
        if (lang === "English") {
          return "I'm Hera, your curator strictly for Korean dramas, Chinese dramas, and Western movies ♡ Tell me what kind of story or mood you're craving, and I'd love to recommend something!";
        }
        return "Aku Hera, kurator khusus untuk K-drama, C-drama, dan film Barat ♡ Yuk kasih tahu mood atau genre tontonan yang lagi kamu cari!";
      }

      // 3. Match catalog entries by keywords, category, mood, and genres
      let filtered = [...STARTER_CATALOG];

      if (/\b(k-drama|kdrama|korea|korean)\b/.test(q)) {
        filtered = filtered.filter(i => i.type === "K-Drama");
      } else if (/\b(c-drama|cdrama|china|chinese|mandarin)\b/.test(q)) {
        filtered = filtered.filter(i => i.type === "C-Drama");
      } else if (/\b(western|barat|movie|film|hollywood|uk|us)\b/.test(q)) {
        filtered = filtered.filter(i => i.type === "Western Movie");
      }

      const keywordWeights = [
        { regex: /\b(comfort|comforting|hangat|capek|lelah|tired|healing|cozy|tenang)\b/, tags: ["comfort", "heartwarming", "feel-good"] },
        { regex: /\b(romanc|romantis|baper|cinta|love|sweet|manis)\b/, tags: ["romance"] },
        { regex: /\b(laugh|lucu|komedi|comedy|ngakak|ringan|fun)\b/, tags: ["comedy", "feel-good"] },
        { regex: /\b(myster|misteri|detektif|teka-teki|thriller|tegang|seru|exciting)\b/, tags: ["mystery", "thriller", "adventure"] },
        { regex: /\b(coming of age|youth|remaja|sekolah|kuliah|persahabatan|keluarga|family)\b/, tags: ["coming of age", "youth", "drama"] }
      ];

      let matchedTags = [];
      keywordWeights.forEach(rule => {
        if (rule.regex.test(q)) {
          matchedTags.push(...rule.tags);
        }
      });

      let scored = filtered.map(item => {
        let score = 0;
        const hay = `${item.title} ${item.genres} ${item.synopsis}`.toLowerCase();
        matchedTags.forEach(tag => {
          if (hay.includes(tag)) score += 3;
        });
        // Direct word matches
        q.split(/\s+/).forEach(word => {
          if (word.length > 3 && hay.includes(word)) score += 1;
        });
        return { item, score };
      });

      scored.sort((a, b) => b.score - a.score);
      const topPicks = (scored[0]?.score > 0 ? scored.filter(s => s.score > 0) : scored).slice(0, 2).map(s => s.item);

      // 4. Format Response based on Language & Tone
      const isShort = tone === "Short & straightforward";
      const isAnalytical = tone === "Detailed & analytical";

      if (lang === "English") {
        const intro = isShort
          ? "Here are two spoiler-free picks from our catalog:"
          : isAnalytical
          ? "Based on the mood and pacing cues in your request, here are two balanced, spoiler-free selections from the HerWatchlist catalog:"
          : "I'd love to help you unwind! Here are two cozy, spoiler-free picks from our catalog that match what you're looking for ♡";

        const cardsText = topPicks.map(p => {
          if (isShort) {
            return `• **${p.title}** (${p.type}, ${p.year}) — ${p.synopsis}`;
          }
          const note = p.content_warning ? ` *(Content note: ${p.content_warning})*` : "";
          return `• **${p.title}** (${p.country} · ${p.year} · ${p.type})\n  *Genres:* ${p.genres}\n  *Why it fits:* ${p.synopsis}${note}`;
        }).join("\n\n");

        const outro = isShort
          ? "Want something different in pacing or country?"
          : "Would you like to lean more toward lighthearted comfort, or something with a bit more emotional depth?";

        return `${intro}\n\n${cardsText}\n\n${outro}`;
      }

      if (lang === "Casual Indo-English") {
        const intro = isShort
          ? "Ini dua rekomendasi spoiler-free dari katalog kita:"
          : isAnalytical
          ? "Berdasarkan vibe dan genre yang kamu cari, ini dua pilihan terkurasi dari katalog HerWatchlist yang pas secara pacing dan mood:"
          : "Aku punya dua rekomendasi manis dan spoiler-free dari katalog HerWatchlist yang pas banget buat kamu ♡";

        const cardsText = topPicks.map(p => {
          if (isShort) {
            return `• **${p.title}** (${p.type}, ${p.year}) — ${p.synopsis}`;
          }
          const note = p.content_warning ? ` *(Content note: ${p.content_warning})*` : "";
          return `• **${p.title}** (${p.country} · ${p.year} · ${p.type})\n  *Genres:* ${p.genres}\n  *Vibe & Premise:* ${p.synopsis}${note}`;
        }).join("\n\n");

        const outro = "Kalau pengen vibe yang lebih spesifik (misalnya lebih ringan atau lebih tegang), bilang aja ya!";
        return `${intro}\n\n${cardsText}\n\n${outro}`;
      }

      // Default: Bahasa Indonesia
      const intro = isShort
        ? "Ini dua rekomendasi bebas spoiler dari katalog HerWatchlist:"
        : isAnalytical
        ? "Berdasarkan preferensi suasana dan genre yang kamu sebutkan, berikut dua pilihan terkurasi dari katalog HerWatchlist:"
        : "Aku pilihkan dua cerita yang pas dan pastinya bebas spoiler dari katalog HerWatchlist buat nemenin waktu santaimu ♡";

      const cardsText = topPicks.map(p => {
        if (isShort) {
          return `• **${p.title}** (${p.type}, ${p.year}) — ${p.synopsis}`;
        }
        const note = p.content_warning ? ` *(Catatan konten: ${p.content_warning})*` : "";
        return `• **${p.title}** (${p.country} · ${p.year} · ${p.type})\n  *Genre:* ${p.genres}\n  *Premis & Kecocokan:* ${p.synopsis}${note}`;
      }).join("\n\n");

      const outro = isShort
        ? "Mau cari genre atau negara lain?"
        : "Dari dua pilihan ini, kamu lebih tertarik ke arah yang hangat-santai atau yang punya alur lebih emosional?";

      return `${intro}\n\n${cardsText}\n\n${outro}`;
    }

    /**
     * Handle Chat Submission
     */
    async function handleChatSubmit(promptText) {
      const trimmed = promptText.trim();
      if (!trimmed) return;

      state.messages.push({ role: "user", content: trimmed });
      renderChatMessages(true);

      const sendBtn = document.getElementById("sendChatBtn");
      sendBtn.disabled = true;

      try {
        let answer = "";

        if (state.apiKey) {
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 35000);

          const response = await fetch("https://api.groq.com/openai/v1/chat/completions", {
            method: "POST",
            headers: {
              "Authorization": `Bearer ${state.apiKey}`,
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              model: "llama-3.3-70b-versatile",
              messages: buildGroqMessages(),
              temperature: Number(state.temperature),
              max_tokens: 800
            }),
            signal: controller.signal
          });

          clearTimeout(timeoutId);

          if (response.status === 401 || response.status === 403) {
            throw new Error("AUTH_ERROR");
          }
          if (response.status === 429) {
            throw new Error("RATE_LIMIT");
          }
          if (!response.ok) {
            throw new Error("API_ERROR");
          }

          const data = await response.json();
          answer = data.choices?.[0]?.message?.content?.trim() || generateLocalHeraResponse(trimmed);
        } else {
          // Slight natural delay for built-in smart curator engine
          await new Promise(resolve => setTimeout(resolve, 420));
          answer = generateLocalHeraResponse(trimmed);
        }

        state.messages.push({ role: "assistant", content: answer });
      } catch (err) {
        let fallbackMsg = "I can't reach the Groq recommendation service right now. Please check your internet connection and API key, or clear the key to use my built-in catalog mode ♡";
        if (err.name === "AbortError") {
          fallbackMsg = "The connection took too long. Please try again in a moment. ♡";
        } else if (err.message === "AUTH_ERROR") {
          fallbackMsg = "Your Groq API key looks invalid or unauthorized. Double-check the key in the sidebar, or leave it blank to use my built-in curator engine ♡";
        } else if (err.message === "RATE_LIMIT") {
          fallbackMsg = "Groq API rate limit reached for a moment. Please wait a few seconds and try again ♡";
        }
        state.messages.push({ role: "assistant", content: fallbackMsg });
      } finally {
        sendBtn.disabled = false;
        renderChatMessages(false);
      }
    }

    /**
     * Initialize Event Listeners & Boot App
     */
    document.addEventListener("DOMContentLoaded", () => {
      loadWatchlistState();
      updateWatchlistBadge();

      // Sidebar Nav Listeners
      document.querySelectorAll(".nav-btn").forEach(btn => {
        btn.addEventListener("click", () => switchTab(btn.dataset.tab));
      });

      // Mobile Sidebar Toggle
      document.getElementById("mobileMenuBtn").addEventListener("click", openMobileSidebar);
      document.getElementById("closeSidebarBtn").addEventListener("click", closeMobileSidebar);
      document.getElementById("sidebarBackdrop").addEventListener("click", closeMobileSidebar);

      // Preferences Listeners
      document.getElementById("prefLanguage").addEventListener("change", (e) => {
        state.language = e.target.value;
      });

      document.getElementById("prefTone").addEventListener("change", (e) => {
        state.tone = e.target.value;
      });

      document.getElementById("prefTemp").addEventListener("input", (e) => {
        state.temperature = parseFloat(e.target.value);
        document.getElementById("tempValueLabel").textContent = state.temperature.toFixed(2);
      });

      // Groq API Key Input (Memory only)
      document.getElementById("groqApiKeyInput").addEventListener("input", (e) => {
        state.apiKey = e.target.value.trim();
        const pill = document.getElementById("apiStatusPill");
        const chatNote = document.getElementById("chatModeNote");

        if (state.apiKey) {
          pill.textContent = "Groq Live Mode";
          pill.className = "text-[10px] font-semibold px-2 py-0.5 rounded-full bg-[#b45c7d] text-white";
          chatNote.textContent = "Connected to Groq API (llama-3.3-70b-versatile) for this session.";
        } else {
          pill.textContent = "Built-in Mode";
          pill.className = "text-[10px] font-semibold px-2 py-0.5 rounded-full bg-[#f8eaf0] text-[#854760] border border-[#efd8e2]";
          chatNote.textContent = "Currently using Hera's built-in smart catalog engine. Add a Groq API key in the sidebar anytime for live Llama 3.3 responses.";
        }
      });

      // Clear Chat History
      document.getElementById("clearChatBtn").addEventListener("click", () => {
        state.messages = [];
        initChatWelcome();
        showToast("Chat history cleared");
      });

      // Discover Filters
      document.getElementById("moodSelector").addEventListener("change", renderMoodSection);
      document.getElementById("categoryFilter").addEventListener("change", renderCatalogGrid);
      document.getElementById("searchInput").addEventListener("input", renderCatalogGrid);

      // Chat Form & Quick Prompts
      document.getElementById("chatForm").addEventListener("submit", (e) => {
        e.preventDefault();
        const input = document.getElementById("chatInput");
        const val = input.value;
        input.value = "";
        handleChatSubmit(val);
      });

      document.querySelectorAll(".quick-prompt-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const text = btn.textContent.replace(/^"|"$/g, "").trim();
          handleChatSubmit(text);
        });
      });

      // Empty Watchlist CTA
      document.getElementById("goToDiscoverBtn").addEventListener("click", () => switchTab("Discover"));

      // Watchlist Status Filter
      const watchlistStatusFilter = document.getElementById("watchlistStatusFilter");
      if (watchlistStatusFilter) {
        watchlistStatusFilter.addEventListener("change", renderWatchlistPage);
      }

      // Initial Render
      initChatWelcome();
      switchTab("Discover");
    });
  </script>
</body>
</html>